```gitignore
# Build files generated by Rust/Cargo
/target/

# Cargo.lock handling
# Ignore for libraries (recommended for your case as a library)
Cargo.lock

# Benchmark test results
/criterion/

# Editor and IDE configuration files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Environment variable files (sensitive information like API keys)
.env
.env.*
!.env.example

# Log files
*.log

# Rust backup files
**/*.rs.bk
*.pdb

# Documentation generation
/doc/
```